F2<-epred_draws(fgs.mod,newdata = new.data,ndraws = 1000,re_formula = NA)
FGDD2_summ <- FGDD2 %>%
group_by(species, leafout_cent) %>%
mean_qi(.epred, .width = 0.90)
F2_summ <- F2 %>%
group_by(species, leafout_cent) %>%
mean_qi(.epred, .width = 0.90)
FGGD2_summ <- FGGD2 %>%
group_by(species, leafout_cent) %>%
mean_qi(.epred, .width = 0.90)
